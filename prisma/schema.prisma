// Схема БД Salary. Деньги — BigInt в минорных единицах (копейки/центы), см. SPEC.md §3.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TxType {
  INCOME
  EXPENSE
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum WalletType {
  CARD
  CASH
  SAVINGS
  OTHER
}

// ─────────────── Аутентификация (таблицы Better Auth) ───────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // Поля приложения (user.additionalFields в lib/auth.ts)
  currency      String   @default("RUB")
  timezone      String   @default("Europe/Moscow")
  onboarded     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]
  goals        Goal[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────── Домен ───────────────

/// «Счёт» в интерфейсе: карта, наличные, сбережения.
model Wallet {
  id             String          @id @default(cuid())
  userId         String
  name           String
  type           WalletType      @default(CARD)
  initialBalance BigInt          @default(0)
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurring      RecurringRule[]

  @@index([userId])
  @@map("wallet")
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  name         String
  type         TxType
  icon         String
  color        String
  archived     Boolean         @default(false)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]

  @@unique([userId, type, name])
  @@index([userId, type])
  @@map("category")
}

model Transaction {
  id          String         @id @default(cuid())
  userId      String
  type        TxType
  /// Всегда > 0, в минорных единицах
  amount      BigInt
  /// Дата без времени, в часовом поясе пользователя
  date        DateTime       @db.Date
  note        String?        @db.VarChar(200)
  categoryId  String
  walletId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  /// Мягкое удаление для кнопки «Отменить»
  deletedAt   DateTime?
  /// Создана регулярным правилом (null — введена вручную или правило удалено)
  recurringId String?
  recurring   RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  wallet      Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, categoryId, date])
  @@map("transaction")
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  /// Первое число месяца
  month      DateTime @db.Date
  limit      BigInt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@map("budget")
}

/// Регулярная операция (PRD v1.1): «зарплата каждый месяц 10-го».
/// Даты повторений считаются от startDate по номеру повторения (count), поэтому 31-е число
/// не «съезжает»: 31 янв → 28 фев → 31 мар.
model RecurringRule {
  id           String        @id @default(cuid())
  userId       String
  type         TxType
  amount       BigInt
  categoryId   String
  walletId     String
  note         String?       @db.VarChar(200)
  frequency    Frequency
  /// Каждые N недель/месяцев/лет
  interval     Int           @default(1)
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  /// Сколько повторений уже создано (номер следующего)
  count        Int           @default(0)
  /// Дата следующего повторения = occurrence(startDate, count)
  nextDate     DateTime      @db.Date
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, active, nextDate])
  @@map("recurring_rule")
}

/// Финансовая цель (PRD v1.1): «Накопить на отпуск 150 000 ₽».
/// Накоплено = сумма пополнений (снятия — отрицательные пополнения).
model Goal {
  id            String             @id @default(cuid())
  userId        String
  name          String
  icon          String
  color         String
  target        BigInt
  deadline      DateTime?          @db.Date
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
  @@map("goal")
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  /// > 0 — пополнение, < 0 — снятие
  amount    BigInt
  date      DateTime @db.Date
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contribution")
}
